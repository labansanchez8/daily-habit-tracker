* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #dfe8f5;
  background: #0b1220;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(50, 112, 255, 0.2), transparent 30%),
    linear-gradient(180deg, #09111b 0%, #101827 100%);
}

body {
  min-height: 100vh;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1180px;
  margin: 0 auto;
  padding: 32px 20px 64px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 8px;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #89a7ff;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.primary-btn {
  border: none;
  border-radius: 12px;
  padding: 0.8rem 1.1rem;
  background: linear-gradient(135deg, #6ea8fe, #7c3aed);
  color: white;
  font-weight: 700;
  box-shadow: 0 10px 30px rgba(124, 58, 237, 0.35);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.stat-card,
.panel {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 18px;
  box-shadow: 0 20px 45px rgba(2, 6, 23, 0.35);
}

.stat-card {
  padding: 22px 18px;
}

.stat-card.accent {
  background: linear-gradient(135deg, rgba(110, 168, 254, 0.2), rgba(124, 58, 237, 0.12));
}

.stat-card span {
  display: block;
  color: #94a3b8;
  margin-bottom: 10px;
}

.stat-card strong {
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.content-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 22px;
  margin-bottom: 22px;
}

.panel {
  padding: 22px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 0;
  font-size: 1.3rem;
}

.habit-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.habit-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #dbeafe;
  font-size: 0.95rem;
}

.habit-form input,
.habit-form select {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(15, 23, 42, 0.8);
  color: white;
  border-radius: 12px;
  padding: 0.85rem 0.9rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.recommendation-item {
  display: flex;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
}

.recommendation-item strong {
  display: block;
  margin-bottom: 4px;
}

.recommendation-item p {
  margin: 0;
  color: #cbd5e1;
}

.dot {
  width: 10px;
  height: 10px;
  margin-top: 8px;
  border-radius: 50%;
  background: linear-gradient(135deg, #38bdf8, #8b5cf6);
  box-shadow: 0 0 18px rgba(56, 189, 248, 0.9);
}

.habits-panel {
  margin-top: 20px;
}

.habit-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
}

.habit-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 18px;
  border-radius: 16px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.habit-card.done {
  border-color: rgba(52, 211, 153, 0.5);
  background: rgba(6, 78, 59, 0.2);
}

.habit-card h3 {
  margin: 6px 0;
  font-size: 1.1rem;
}

.habit-card p {
  margin: 0;
  color: #a5b4cf;
}

.habit-tag {
  display: inline-block;
  padding: 0.3rem 0.6rem;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.16);
  color: #bfdbfe;
  font-size: 0.72rem;
}

.toggle-btn {
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: transparent;
  color: white;
  border-radius: 12px;
  padding: 0.8rem 0.9rem;
  min-width: 120px;
  transition: 0.2s ease;
}

.toggle-btn.done {
  background: linear-gradient(135deg, #10b981, #059669);
  border-color: transparent;
}

@media (max-width: 820px) {
  .content-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .habit-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .toggle-btn {
    width: 100%;
  }
}
